# Local control-plane defaults. Compose supplies service-host URLs automatically.
CONTROL_PLANE_HTTP_ADDR=:8080
DATABASE_URL=postgres://registration:registration-local-only@127.0.0.1:5432/registration?sslmode=disable
REDIS_URL=redis://127.0.0.1:6379/0
READINESS_TIMEOUT=2s
STARTUP_TIMEOUT=45s
SHUTDOWN_TIMEOUT=10s
AUTO_MIGRATE=true
DB_MAX_OPEN_CONNS=25
DB_MAX_IDLE_CONNS=10
DB_CONN_MAX_LIFETIME=30m
