+def test_saved_proxy_session_refreshes_provider_sid_after_transport_failure():
+    """保存代理 session 被 SOCKS5 拒绝时，第二次请求刷新 sid。"""
+    first_error = RuntimeError("ProxyError: Failed to perform, curl: (97) User was rejected by the SOCKS5 server")
+    responses = [
+        first_error,
+        _Response(_plus_payload()),
+    ]
+    envs = []
+
+    def make_session(*, proxy, **_kwargs):
+        env = SimpleNamespace(
+            device_id="saved-device",
+            proxy=proxy,
+            session=SimpleNamespace(cookies=MagicMock(), close=MagicMock()),
+            get_chatgpt_headers=lambda **_kwargs: {},
+            navigator_language=lambda: "zh-CN",
+            get=MagicMock(side_effect=[responses[len(envs)]]),
+        )
+        envs.append(env)
+        return env
+
+    saved_proxy = "socks5://user-region-JP-sid-OLD123-t-5:pass@proxy.example:3000"
+    with patch("core.chatgpt_plan.BrowserSession", side_effect=make_session), patch(
+        "core.chatgpt_plan.time.sleep"
+    ), patch("core.chatgpt_plan.rotate_proxy_session", return_value="socks5://user-region-JP-sid-NEW456-t-5:pass@proxy.example:3000"):
+        result = chatgpt_plan.check_account_plan(
+            "TOKEN",
+            proxy=saved_proxy,
+            account_id="account-1",
+            device_id="saved-device",
+            preserve_proxy_session=True,
+            max_attempts=2,
+        )
+
+    assert result["ok"] is True
+    assert [env.proxy for env in envs] == [saved_proxy, "socks5://user-region-JP-sid-NEW456-t-5:pass@proxy.example:3000"]
+    assert result["network_route"] == "proxy_session_fallback"
+    assert result["proxy_fallback_reason"]
+
+
+def test_saved_proxy_session_refreshes_provider_sid_for_country_qualification_failure():
+    """套餐成功但资格 Checkout 被 SOCKS5 拒绝时，只重试资格阶段。"""
+    envs = []
+    qualification_results = [
+        {
+            "country_qualification_status": "failed",
+            "country_qualification_results": [{
+                "status": "failed",
+                "error": "ProxyError: curl: (97) User was rejected by the SOCKS5 server",
+            }],
+        },
+        {
+            "country_qualification_status": "success",
+            "country_qualification_results": [{"status": "not_eligible", "eligible": False}],
+        },
+    ]
+
+    def make_session(*, proxy, **_kwargs):
+        env = SimpleNamespace(
+            device_id="saved-device",
+            proxy=proxy,
+            session=SimpleNamespace(cookies=MagicMock(), close=MagicMock()),
+            get_chatgpt_headers=lambda **_kwargs: {},
+            navigator_language=lambda: "zh-CN",
+            get=MagicMock(return_value=_Response(_plus_payload())),
+        )
+        envs.append(env)
+        return env
+
+    saved_proxy = "socks5://user-region-JP-sid-OLD123-t-5:pass@proxy.example:3000"
+    with patch("core.chatgpt_plan.BrowserSession", side_effect=make_session), patch(
+        "core.chatgpt_plan.check_country_qualification", side_effect=qualification_results
+    ) as check, patch(
+        "core.chatgpt_plan.rotate_proxy_session",
+        return_value="socks5://user-region-JP-sid-NEW456-t-5:pass@proxy.example:3000",
+    ):
+        result = chatgpt_plan.check_account_plan(
+            "TOKEN",
+            proxy=saved_proxy,
+            account_id="account-1",
+            device_id="saved-device",
+            billing_country="JP",
+            check_country_qualification=True,
+            preserve_proxy_session=True,
+            max_attempts=2,
+        )
+
+    assert result["ok"] is True
+    assert result["country_qualification_status"] == "success"
+    assert check.call_count == 2
+    assert [env.proxy for env in envs] == [saved_proxy, "socks5://user-region-JP-sid-NEW456-t-5:pass@proxy.example:3000"]
+    assert envs[0].session.close.called
+    assert result["network_route"] == "proxy_session_fallback"
