+def _is_invalid_email_otp_response(status: int, error_text: str) -> bool:
+    text = str(error_text or "").lower()
+    return int(status or 0) == 401 or (
+        int(status or 0) in {400, 403, 422}
+        and any(
+            marker in text
+            for marker in (
+                "invalid_code",
+                "invalid code",
+                "invalid_otp",
+                "invalid otp",
+                "expired_code",
+                "expired code",
+                "code_invalid",
+            )
+        )
+    )
+
