+async function clearAccountLogsV2() {
+  const btn = document.getElementById('btnClearAccountLogsV2');
+  const status = document.getElementById('accountLogCleanupStatusV2');
+  if (!btn || !status) return;
+  if (!await appConfirm('确定清理全部账号日志吗？\n\n将删除查活、提链、重设2FA和 Codex 补跑日志。')) return;
